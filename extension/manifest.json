{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Company Form Filler",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "fr",
  "author": "Thodebug",
  "homepage_url": "https://github.com/Thodebug/company-form-filler",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["menus", "contextMenus", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "generators/random.js",
      "generators/checksums.js",
      "generators/text.js",
      "generators/company.js",
      "background/data.js",
      "background/store.js",
      "background/tabs-state.js",
      "background/menus.js",
      "background/background.js"
    ],
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "vocab/fr.js",
        "shared/format.js",
        "content/detection.js",
        "content/fill.js",
        "content/banner.js",
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_end"
    }
  ],
  "incognito": "spanning",
  "minimum_chrome_version": "123",
  "browser_specific_settings": {
    "gecko": {
      "id": "siret-form-filler@thodebug.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
